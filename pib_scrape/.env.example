# Optional overrides (copy to .env)

# PIB_SCRAPE_LISTING_URL=https://www.pib.gov.in/allRel.aspx?reg=3&lang=1
# PIB_SCRAPE_BASE_URL=https://www.pib.gov.in

# Local Chroma persist directory (created on first upsert)
# PIB_SCRAPE_PERSIST_DIR=./data/chroma
# PIB_SCRAPE_COLLECTION=pib_releases

# Politeness
# PIB_SCRAPE_REQUEST_DELAY_SECONDS=1.5
# PIB_SCRAPE_REQUEST_TIMEOUT_SECONDS=45
# PIB_SCRAPE_MAX_RETRIES=3

# Chunk packing size (characters)
# PIB_SCRAPE_MAX_CHARS=1800

# Browser-like UA required: Akamai on pib.gov.in returns 403 for custom bot UAs.
# PIB_SCRAPE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
